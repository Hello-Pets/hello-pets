{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@assets/*": ["./src/shared/assets/*"],
      "@components/*": ["./src/shared/components/*"],
      "@constants/*": ["./src/shared/constants/*"],
      "@layouts/*": ["./src/shared/layouts/*"],
      "@lib/*": ["./src/shared/lib/*"],
